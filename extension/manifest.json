{
  "manifest_version": 3,
  "name": "Kiroku for Google Meet",
  "version": "0.3.0",
  "description": "Record any tab (Google Meet) into your local Kiroku app. Calendar-aware, offline Indic transcription — nothing leaves your machine.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "activeTab", "offscreen", "storage", "notifications", "alarms", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8010/*",
    "http://localhost:8010/*",
    "https://calendar.google.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Start/stop recording the current tab"
    }
  }
}
